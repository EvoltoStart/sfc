.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-tag--info {
  color: #38657b;
  background: rgba(225, 240, 250, 0.92);
}

.status-tag--safe {
  color: #2a6f46;
  background: rgba(227, 243, 231, 0.96);
}

.status-tag--warn {
  color: #9b6a22;
  background: rgba(255, 241, 217, 0.96);
}

.status-tag--danger {
  color: #a44343;
  background: rgba(255, 232, 232, 0.96);
}
