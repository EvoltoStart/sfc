<view class="page-shell">
  <view class="page-content">
    <view class="header-card">
      <view class="topbar">
        <view>
          <view class="hero-kicker">乘客端 · 顺路搜索</view>
          <view class="hero-title hero-title--large">今天想顺着哪阵风出发？</view>
          <view class="hero-desc">
            {{profileDisplayName}}，先看顺路度、价格和安全状态，再决定是否申请同行。
          </view>
        </view>
        <view class="topbar__aside">
          <text class="topbar__value">{{featuredTotalText}}</text>
          <text class="topbar__label">实时推荐</text>
        </view>
      </view>
      <view class="metrics-row" style="margin-top: 22rpx;">
        <view class="metric-pill">
          <text class="metric-pill__value">{{loginStateText}}</text>
          <text class="metric-pill__label">登录状态</text>
        </view>
        <view class="metric-pill">
          <text class="metric-pill__value">{{searchDraft.minRouteScore}}%</text>
          <text class="metric-pill__label">顺路度门槛</text>
        </view>
        <view class="metric-pill">
          <text class="metric-pill__value">{{searchDraft.departTime}}</text>
          <text class="metric-pill__label">本次出发时间</text>
        </view>
      </view>
    </view>

    <view wx:if="{{!authState.token}}" class="hero-card hero-card--accent">
      <view class="section-heading">
        <view class="section-heading__body">
          <view class="section-title">先登录账号</view>
          <view class="section-desc">可选择快捷账号，也可以使用微信登录。</view>
        </view>
      </view>
      <view class="quick-login-grid">
        <button
          wx:for="{{quickLoginCodes}}"
          wx:key="code"
          class="button-secondary quick-login-button"
          data-code="{{item.code}}"
          bindtap="handleQuickLogin"
          loading="{{loggingIn}}"
        >
          {{item.label}}
        </button>
      </view>
      <view class="field-group" style="margin-top: 18rpx;">
          <text class="field-label">自定义登录码</text>
        <input
          class="field-input"
          placeholder="例如 passenger-alpha / driver-alpha"
          value="{{loginCode}}"
          bindinput="handleLoginCodeInput"
        />
      </view>
      <view class="button-row" style="margin-top: 18rpx;">
        <button class="button-primary" bindtap="handleLoginSubmit" loading="{{loggingIn}}">登录</button>
        <button class="button-ghost" bindtap="handleWechatLogin" loading="{{loggingIn}}">微信登录</button>
      </view>
    </view>

    <view class="hero-card">
      <view class="section-heading">
        <view class="section-heading__body">
          <view class="section-title">搜索条件</view>
          <view class="section-desc">选择路线、时间和顺路度门槛后查看推荐车主。</view>
        </view>
        <button class="button-ghost button-inline" bindtap="handleGoProfile">去我的</button>
      </view>
      <view class="chip-row" style="margin-top: 18rpx;">
        <view
          wx:for="{{routePresetItems}}"
          wx:key="id"
          class="{{item.chipClass}}"
          data-preset="{{item.id}}"
          bindtap="handlePresetTap"
        >
          {{item.routeName}}
        </view>
      </view>
      <view class="field-group" style="margin-top: 18rpx;">
        <text class="field-label">起点</text>
        <input class="field-input" data-field="startName" value="{{searchDraft.startName}}" bindinput="handleSearchFieldInput" />
      </view>
      <view class="field-group" style="margin-top: 18rpx;">
        <text class="field-label">终点</text>
        <input class="field-input" data-field="endName" value="{{searchDraft.endName}}" bindinput="handleSearchFieldInput" />
      </view>
      <view class="grid-two" style="margin-top: 18rpx;">
        <view class="field-group">
          <text class="field-label">出发日期</text>
          <picker mode="date" value="{{searchDraft.departDate}}" bindchange="handleDateChange">
            <view class="field-picker">{{searchDraft.departDate}}</view>
          </picker>
        </view>
        <view class="field-group">
          <text class="field-label">出发时间</text>
          <picker mode="time" value="{{searchDraft.departTime}}" bindchange="handleTimeChange">
            <view class="field-picker">{{searchDraft.departTime}}</view>
          </picker>
        </view>
      </view>
      <view class="field-group" style="margin-top: 18rpx;">
        <text class="field-label">最低顺路度</text>
        <input class="field-input" type="number" data-field="minRouteScore" value="{{searchDraft.minRouteScore}}" bindinput="handleSearchFieldInput" />
      </view>
      <view class="button-row" style="margin-top: 20rpx;">
        <button class="button-primary" bindtap="handleSearch" loading="{{loading}}">看看顺路推荐</button>
        <button class="button-secondary" bindtap="handleRefreshFeatured" loading="{{loading}}">刷新首页推荐</button>
      </view>
    </view>

    <view class="section-heading">
      <view class="section-heading__body">
        <view class="section-title">今天适合的车主</view>
        <view class="section-desc">默认展示当前搜索条件下的前 3 条推荐行程。</view>
      </view>
    </view>

    <empty-state
      wx:if="{{!featuredMatches.length}}"
      title="还没有推荐结果"
      description="登录后点击“看看顺路推荐”，即可查看可申请的同行行程。"
      action-text="立即搜索"
      bind:action="handleSearch"
    />

    <view wx:for="{{featuredMatches}}" wx:key="tripId" class="record-card record-card--highlight">
      <view class="record-card__header">
        <view class="inline-row">
          <view class="avatar-badge">{{item.avatarText}}</view>
          <view>
            <view class="record-card__title">{{item.driverName}}</view>
            <view class="record-card__sub">{{item.ratingText}} · {{item.departText}}</view>
          </view>
        </view>
        <status-tag text="{{item.routeScoreText}}" tone="safe" />
      </view>
      <view class="record-card__row">
        <view>
          <view class="record-card__value">{{item.feeText}}</view>
          <view class="record-card__caption">预估费用</view>
        </view>
        <view>
          <view class="record-card__value">{{item.seatAvailable}}</view>
          <view class="record-card__caption">{{item.seatText}}</view>
        </view>
      </view>
      <view class="record-card__meta">
        <text>行程 ID {{item.tripId}}</text>
        <text>排序分 {{item.sortScore}}</text>
      </view>
      <view class="record-card__actions">
        <button class="button-ghost button-inline" data-trip-id="{{item.tripId}}" bindtap="handleOpenTrip">查看详情</button>
      </view>
    </view>

    <view class="panel-card">
      <view class="section-title">当前可用</view>
      <view wx:for="{{capabilityNotes}}" wx:key="*this" class="hero-note hero-note--safe">
        {{item}}
      </view>
    </view>

    <view class="panel-card">
      <view class="section-title">常见问题</view>
      <view wx:for="{{faqItems}}" wx:key="id" class="info-strip" style="margin-top: 14rpx;">
        <view class="info-strip__title">{{item.question}}</view>
        <view class="info-strip__desc">{{item.answer}}</view>
      </view>
    </view>

    <view class="footer-space"></view>
  </view>

  <bottom-nav active="home" />
</view>
