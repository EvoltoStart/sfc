<view class="page-shell">
  <view class="page-content">
    <view class="header-card">
      <view class="topbar">
        <view>
          <view class="hero-kicker">订单中心 · 双视角</view>
          <view class="hero-title">把申请、订单、行程和接单动作放在一个工作台里</view>
          <view class="hero-desc">乘客看申请与支付进度，车主看待处理报名和发布行程后的履约状态。</view>
        </view>
        <view class="topbar__aside">
          <text class="topbar__value">{{headerCountText}}</text>
          <text class="topbar__label">当前可见订单</text>
        </view>
      </view>
      <view class="chip-row" style="margin-top: 24rpx;">
        <view class="{{passengerRoleClass}}" data-role="PASSENGER" bindtap="handleRoleChange">乘客视角</view>
        <view class="{{driverRoleClass}}" data-role="DRIVER" bindtap="handleRoleChange">车主视角</view>
        <view class="chip chip--soft" bindtap="handleRefresh">刷新数据</view>
      </view>
      <view class="metrics-row" style="margin-top: 22rpx;">
        <view class="metric-pill">
          <text class="metric-pill__value">{{passengerRequests.length}}</text>
          <text class="metric-pill__label">乘客申请</text>
        </view>
        <view class="metric-pill">
          <text class="metric-pill__value">{{driverTrips.length}}</text>
          <text class="metric-pill__label">我的行程</text>
        </view>
        <view class="metric-pill">
          <text class="metric-pill__value">{{driverRequests.length}}</text>
          <text class="metric-pill__label">待处理报名</text>
        </view>
      </view>
    </view>

    <empty-state
      wx:if="{{!authState.token}}"
      title="还没有登录"
      description="订单中心需要真实账号才能拉取乘客申请、订单和车主接单数据。"
      action-text="去我的登录"
      bind:action="handleGoProfile"
    />

    <view wx:if="{{showPassengerView}}">
      <view class="section-heading">
        <view class="section-heading__body">
          <view class="section-title">我的申请</view>
          <view class="section-desc">司机还在确认时看这里，确认后会在订单列表里出现可支付订单。</view>
        </view>
      </view>

      <empty-state
        wx:if="{{!passengerRequests.length}}"
        title="还没有同行申请"
        description="去首页搜索后申请同行，这里会出现真实的申请状态。"
      />

      <view wx:for="{{passengerRequests}}" wx:key="joinRequestId" class="record-card">
        <view class="record-card__header">
          <view>
            <view class="record-card__title">{{item.routeSummary}}</view>
            <view class="record-card__sub">{{item.driverName}} · {{item.ratingText}} · {{item.createdText}}</view>
          </view>
          <status-tag text="{{item.statusMeta.label}}" tone="{{item.statusMeta.tone}}" />
        </view>
        <view class="record-card__meta">
          <text>申请号 {{item.joinRequestId}}</text>
          <text>行程 {{item.tripId}}</text>
        </view>
        <view class="record-card__actions">
          <button class="button-ghost button-inline" data-kind="join" data-id="{{item.joinRequestId}}" bindtap="handleOpenDetail">查看申请详情</button>
        </view>
      </view>

      <view class="section-heading" style="margin-top: 10rpx;">
        <view class="section-heading__body">
          <view class="section-title">我的订单</view>
          <view class="section-desc">支付、上车、到达确认都从订单详情继续往下走。</view>
        </view>
      </view>

      <empty-state
        wx:if="{{!passengerOrders.length}}"
        title="还没有乘客订单"
        description="司机接受申请后，这里会出现真实订单和支付入口。"
      />

      <view wx:for="{{passengerOrders}}" wx:key="orderId" class="record-card record-card--highlight">
        <view class="record-card__header">
          <view>
            <view class="record-card__title">{{item.routeSummary}}</view>
            <view class="record-card__sub">{{item.relationName}} · {{item.departText}}</view>
          </view>
          <status-tag text="{{item.statusMeta.label}}" tone="{{item.statusMeta.tone}}" />
        </view>
        <view class="record-card__row">
          <view>
            <view class="record-card__value">{{item.payableText}}</view>
            <view class="record-card__caption">应付金额</view>
          </view>
          <view>
            <view class="record-card__value">{{item.orderNo}}</view>
            <view class="record-card__caption">订单号</view>
          </view>
        </view>
        <view class="record-card__actions">
          <button class="button-primary button-inline" data-kind="order" data-id="{{item.orderId}}" bindtap="handleOpenDetail">打开订单详情</button>
        </view>
      </view>
    </view>

    <view wx:if="{{showDriverView}}">
      <view wx:if="{{driverRoleHint}}" class="hero-note hero-note--warn">
        {{driverRoleHint}}
      </view>

      <view class="section-heading">
        <view class="section-heading__body">
          <view class="section-title">我的行程</view>
          <view class="section-desc">这里展示发布后的真实行程，便于观察座位、状态和报名量。</view>
        </view>
      </view>

      <empty-state
        wx:if="{{!driverTrips.length}}"
        title="还没有车主行程"
        description="去发布页创建一条真实行程后，这里会出现状态和报名数。"
      />

      <view wx:for="{{driverTrips}}" wx:key="tripId" class="record-card">
        <view class="record-card__header">
          <view>
            <view class="record-card__title">{{item.routeSummary}}</view>
            <view class="record-card__sub">{{item.departText}}</view>
          </view>
          <status-tag text="{{item.statusMeta.label}}" tone="{{item.statusMeta.tone}}" />
        </view>
        <view class="record-card__meta">
          <text>行程 {{item.tripId}}</text>
          <text>余座 {{item.seatAvailable}} / {{item.seatTotal}}</text>
          <text>报名 {{item.applyCount}}</text>
        </view>
      </view>

      <view class="section-heading" style="margin-top: 10rpx;">
        <view class="section-heading__body">
          <view class="section-title">待处理报名</view>
          <view class="section-desc">接受申请后系统会自动生成真实订单，乘客侧会进入支付链路。</view>
        </view>
      </view>

      <empty-state
        wx:if="{{!driverRequests.length}}"
        title="还没有待处理报名"
        description="乘客申请同行后，这里会出现信用标签、历史订单数和处理动作。"
      />

      <view wx:for="{{driverRequests}}" wx:key="joinRequestId" class="record-card record-card--highlight">
        <view class="record-card__header">
          <view>
            <view class="record-card__title">{{item.passengerName}}</view>
            <view class="record-card__sub">{{item.ratingText}} · {{item.applyText}}</view>
          </view>
          <status-tag text="{{item.statusMeta.label}}" tone="{{item.statusMeta.tone}}" />
        </view>
        <view class="record-card__meta">
          <text>申请 {{item.joinRequestId}}</text>
          <text>行程 {{item.tripId}}</text>
          <text>{{item.creditText}}</text>
        </view>
        <view wx:if="{{item.showActions}}" class="record-card__actions">
          <button class="button-primary button-inline" data-id="{{item.joinRequestId}}" bindtap="handleAcceptRequest">接受</button>
          <button class="button-danger button-inline" data-id="{{item.joinRequestId}}" bindtap="handleRejectRequest">拒绝</button>
        </view>
      </view>

      <view class="section-heading" style="margin-top: 10rpx;">
        <view class="section-heading__body">
          <view class="section-title">司机订单</view>
          <view class="section-desc">上车确认、到达确认完成后，钱包会进入真实结算链路。</view>
        </view>
      </view>

      <empty-state
        wx:if="{{!driverOrders.length}}"
        title="还没有司机订单"
        description="一旦接受申请并生成订单，这里会展示应收金额和履约状态。"
      />

      <view wx:for="{{driverOrders}}" wx:key="orderId" class="record-card">
        <view class="record-card__header">
          <view>
            <view class="record-card__title">{{item.routeSummary}}</view>
            <view class="record-card__sub">{{item.relationName}} · {{item.departText}}</view>
          </view>
          <status-tag text="{{item.statusMeta.label}}" tone="{{item.statusMeta.tone}}" />
        </view>
        <view class="record-card__row">
          <view>
            <view class="record-card__value">{{item.payableText}}</view>
            <view class="record-card__caption">乘客支付金额</view>
          </view>
          <view>
            <view class="record-card__value">{{item.orderNo}}</view>
            <view class="record-card__caption">订单号</view>
          </view>
        </view>
        <view class="record-card__actions">
          <button class="button-primary button-inline" data-kind="order" data-id="{{item.orderId}}" bindtap="handleOpenDetail">查看履约详情</button>
        </view>
      </view>
    </view>

    <view class="footer-space"></view>
  </view>

  <bottom-nav active="order" />
</view>
