<view class="page-shell">
  <view class="page-content">
    <view class="header-card">
      <view class="topbar">
        <view>
          <view class="hero-kicker">我的 · 账号中枢</view>
          <view class="hero-title">{{profileDisplayName}}，把资料、认证和司机入口都收在一起</view>
          <view class="hero-desc">同一个账号承接乘客和车主两种视角，登录状态直接驱动首页、订单、发布和钱包的真实联调。</view>
        </view>
        <view class="topbar__aside">
          <text class="topbar__value">{{rolePreferenceText}}</text>
          <text class="topbar__label">当前偏好角色</text>
        </view>
      </view>
      <view class="chip-row" style="margin-top: 22rpx;">
        <view class="{{passengerRoleClass}}" data-role="PASSENGER" bindtap="handleRoleChange">乘客模式</view>
        <view class="{{driverRoleClass}}" data-role="DRIVER" bindtap="handleRoleChange">车主模式</view>
      </view>
    </view>

    <view wx:if="{{!authState.token}}" class="hero-card hero-card--accent">
      <view class="section-title">登录真实账号</view>
      <view class="section-desc">开发联调时推荐直接用 code 登录，后面再切微信登录和真机验证。</view>
      <view class="quick-login-grid">
        <button
          wx:for="{{quickLoginCodes}}"
          wx:key="code"
          class="button-secondary quick-login-button"
          data-code="{{item.code}}"
          bindtap="handleQuickLogin"
          loading="{{loggingIn}}"
        >
          {{item.label}}
        </button>
      </view>
      <view class="field-group" style="margin-top: 18rpx;">
        <text class="field-label">自定义登录 code</text>
        <input class="field-input" value="{{loginCode}}" bindinput="handleLoginCodeInput" placeholder="例如 driver-alpha" />
      </view>
      <view class="button-row" style="margin-top: 18rpx;">
        <button class="button-primary" bindtap="handleLoginSubmit" loading="{{loggingIn}}">开发 code 登录</button>
        <button class="button-ghost" bindtap="handleWechatLogin" loading="{{loggingIn}}">微信登录</button>
      </view>
    </view>

    <view wx:if="{{authState.token}}" class="panel-card">
      <view class="section-title">账号概览</view>
      <view class="meta-grid" style="margin-top: 18rpx;">
        <view class="meta-item">
          <text class="meta-item__label">用户 ID</text>
          <text class="meta-item__value">{{profileUserIdText}}</text>
        </view>
        <view class="meta-item">
          <text class="meta-item__label">实名状态</text>
          <text class="meta-item__value">{{realnameLabelText}}</text>
        </view>
        <view class="meta-item">
          <text class="meta-item__label">司机状态</text>
          <text class="meta-item__value">{{driverStatusLabelText}}</text>
        </view>
        <view class="meta-item">
          <text class="meta-item__label">驾驶证状态</text>
          <text class="meta-item__value">{{licenseStatusLabelText}}</text>
        </view>
      </view>
      <view class="hero-note hero-note--safe">
        当前角色集合：{{roleSummaryText}}。切换偏好角色不会改后端权限，只改变前端默认工作台。
      </view>
    </view>

    <view wx:if="{{authState.token}}" class="hero-card">
      <view class="section-title">个人资料</view>
      <view class="section-desc">昵称和头像地址会走真实资料更新接口，保存后首页和订单会同步显示。</view>
      <view class="field-group" style="margin-top: 18rpx;">
        <text class="field-label">昵称</text>
        <input class="field-input" data-field="nickname" value="{{profileDraft.nickname}}" bindinput="handleProfileInput" />
      </view>
      <view class="field-group" style="margin-top: 18rpx;">
        <text class="field-label">头像 URL</text>
        <input class="field-input" data-field="avatarUrl" value="{{profileDraft.avatarUrl}}" bindinput="handleProfileInput" />
      </view>
      <view class="button-row" style="margin-top: 20rpx;">
        <button class="button-primary" bindtap="handleSaveProfile" loading="{{savingProfile}}">保存资料</button>
      </view>
    </view>

    <view wx:if="{{authState.token}}" class="hero-card hero-card--accent">
      <view class="section-title">实名认证</view>
      <view class="section-desc">保持一个最小但真实可提交通道，提交后会刷新后端审核状态。</view>
      <view class="field-group" style="margin-top: 18rpx;">
        <text class="field-label">姓名</text>
        <input class="field-input" data-field="realName" value="{{realnameDraft.realName}}" bindinput="handleRealnameInput" />
      </view>
      <view class="field-group" style="margin-top: 18rpx;">
        <text class="field-label">身份证号</text>
        <input class="field-input" data-field="idCardNo" value="{{realnameDraft.idCardNo}}" bindinput="handleRealnameInput" />
      </view>
      <view class="{{realnameNoteClass}}">
        当前状态：{{realnameStatusLabel}}。
        {{realnameNoteText}}
      </view>
      <view class="button-row" style="margin-top: 20rpx;">
        <button class="button-primary" bindtap="handleSubmitRealname" loading="{{submittingRealname}}">提交实名认证</button>
      </view>
    </view>

    <view wx:if="{{authState.token}}" class="panel-card">
      <view class="section-title">司机能力入口</view>
      <view class="section-desc">车辆、驾驶证和钱包都拆成独立分包页面，避免和后端代码或乘客页面混在一起。</view>
      <view class="grid-three" style="margin-top: 18rpx;">
        <button class="button-secondary profile-shortcut" bindtap="handleGoVehicles">车辆</button>
        <button class="button-secondary profile-shortcut" bindtap="handleGoLicense">驾驶证</button>
        <button class="button-secondary profile-shortcut" bindtap="handleGoWallet">钱包</button>
      </view>
      <view class="button-row" style="margin-top: 20rpx;">
        <button class="button-danger" bindtap="handleLogout">退出登录</button>
      </view>
    </view>

    <view class="footer-space"></view>
  </view>

  <bottom-nav active="profile" />
</view>
