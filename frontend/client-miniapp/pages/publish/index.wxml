<view class="page-shell">
  <view class="page-content">
    <view class="header-card">
      <view class="topbar">
        <view>
          <view class="hero-kicker">车主端 · 发布行程</view>
          <view class="hero-title">把路线、车辆、座位和平台规则一次说清楚</view>
          <view class="hero-desc">发布前先确认价格预览、顺路度、车辆和座位数。</view>
        </view>
        <view class="topbar__aside">
          <text class="topbar__value">{{routeScoreTopText}}</text>
          <text class="topbar__label">当前顺路度</text>
        </view>
      </view>
      <view class="metrics-row" style="margin-top: 22rpx;">
        <view class="metric-pill">
          <text class="metric-pill__value">{{vehicles.length}}</text>
          <text class="metric-pill__label">可用车辆</text>
        </view>
        <view class="metric-pill">
          <text class="metric-pill__value">{{publishDraft.seatTotal}}</text>
          <text class="metric-pill__label">计划座位</text>
        </view>
        <view class="metric-pill">
          <text class="metric-pill__value">{{previewTotalText}}</text>
          <text class="metric-pill__label">预估总价</text>
        </view>
      </view>
    </view>

    <empty-state
      wx:if="{{!authState.token}}"
      title="先登录车主账号"
      description="发布行程需要登录账号、车辆和司机能力状态。"
      action-text="去我的登录"
      bind:action="handleGoProfile"
    />

    <view wx:if="{{authState.token}}">
      <view class="hero-note hero-note--warn" wx:if="{{showDriverSummary}}">
        {{driverLicenseSummary}}
        若发布失败，通常是车辆或司机认证还未满足规则。
      </view>

      <view class="hero-card hero-card--accent">
        <view class="section-title">本次发布配置</view>
        <view class="section-desc">路线预设用于填充起终点，可按本次出行再做调整。</view>
        <view class="chip-row" style="margin-top: 18rpx;">
          <view
            wx:for="{{routePresetItems}}"
            wx:key="id"
            class="{{item.chipClass}}"
            data-preset="{{item.id}}"
            bindtap="handlePresetTap"
          >
            {{item.routeName}}
          </view>
        </view>
        <view class="field-group" style="margin-top: 18rpx;">
          <text class="field-label">起点</text>
          <input class="field-input" data-field="startName" value="{{publishDraft.startName}}" bindinput="handleFieldInput" />
        </view>
        <view class="field-group" style="margin-top: 18rpx;">
          <text class="field-label">终点</text>
          <input class="field-input" data-field="endName" value="{{publishDraft.endName}}" bindinput="handleFieldInput" />
        </view>
        <view class="grid-two" style="margin-top: 18rpx;">
          <view class="field-group">
            <text class="field-label">出发日期</text>
            <picker mode="date" value="{{publishDraft.departDate}}" bindchange="handleDateChange">
              <view class="field-picker">{{publishDraft.departDate}}</view>
            </picker>
          </view>
          <view class="field-group">
            <text class="field-label">出发时间</text>
            <picker mode="time" value="{{publishDraft.departTime}}" bindchange="handleTimeChange">
              <view class="field-picker">{{publishDraft.departTime}}</view>
            </picker>
          </view>
        </view>
        <view class="grid-two" style="margin-top: 18rpx;">
          <view class="field-group">
            <text class="field-label">车辆</text>
            <picker mode="selector" range="{{vehicleOptions}}" value="{{vehicleIndex}}" bindchange="handleVehicleChange">
              <view class="field-picker">{{selectedVehicleText}}</view>
            </picker>
          </view>
          <view class="field-group">
            <text class="field-label">座位数</text>
            <input class="field-input" type="number" data-field="seatTotal" value="{{publishDraft.seatTotal}}" bindinput="handleFieldInput" />
          </view>
        </view>
        <view class="button-row" style="margin-top: 20rpx;">
          <button class="button-secondary" bindtap="handlePreview" loading="{{previewing}}">刷新预览</button>
          <button class="button-ghost" bindtap="handleSaveTemplate">保存常用路线</button>
        </view>
      </view>

      <view class="panel-card">
        <view class="section-heading">
          <view class="section-heading__body">
            <view class="section-title">价格与顺路度</view>
            <view class="section-desc">发布前确认总价、服务费、距离和顺路度。</view>
          </view>
          <button class="button-ghost button-inline" bindtap="handleGoVehicles">管理车辆</button>
        </view>
        <view class="meta-grid" style="margin-top: 18rpx;">
          <view class="meta-item">
            <text class="meta-item__label">总价</text>
            <text class="meta-item__value">{{previewTotalText}}</text>
          </view>
          <view class="meta-item">
            <text class="meta-item__label">平台服务费</text>
            <text class="meta-item__value">{{previewServiceText}}</text>
          </view>
          <view class="meta-item">
            <text class="meta-item__label">距离</text>
            <text class="meta-item__value">{{previewDistanceText}}</text>
          </view>
          <view class="meta-item">
            <text class="meta-item__label">顺路度</text>
            <text class="meta-item__value">{{routeScoreText}}</text>
          </view>
        </view>
        <view wx:if="{{routeScore}}" class="{{routeScoreNoteClass}}">
          {{routeScoreNoteText}}
        </view>
      </view>

      <view class="panel-card">
        <view class="section-heading">
          <view class="section-heading__body">
            <view class="section-title">常用路线</view>
            <view class="section-desc">保存高频路线，后续发布时可快速参考。</view>
          </view>
          <button class="button-ghost button-inline" bindtap="handleGoLicense">驾驶证</button>
        </view>
        <empty-state
          wx:if="{{!routeTemplates.length}}"
          title="还没有常用路线"
          description="点击“保存常用路线”后，会在此显示路线摘要。"
        />
        <view wx:for="{{routeTemplates}}" wx:key="id" class="record-card">
          <view class="record-card__header">
            <view>
              <view class="record-card__title">{{item.routeName}}</view>
              <view class="record-card__sub">{{item.startName}} → {{item.endName}} · {{item.timePeriod}}</view>
            </view>
            <status-tag text="{{item.statusText}}" tone="{{item.statusTone}}" />
          </view>
          <view class="record-card__actions">
            <button wx:if="{{!item.isDefault}}" class="button-ghost button-inline" data-id="{{item.id}}" bindtap="handleSetDefaultTemplate">设为默认</button>
          </view>
        </view>
      </view>

      <view class="button-row">
        <button class="button-primary" bindtap="handleCreateTrip" loading="{{submitting}}">确认发布行程</button>
      </view>
    </view>

    <view class="footer-space"></view>
  </view>

  <bottom-nav active="publish" />
</view>
