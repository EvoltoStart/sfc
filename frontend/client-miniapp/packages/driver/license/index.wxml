<view class="page-shell">
  <view class="page-content">
    <view class="header-card">
      <view class="topbar">
        <view>
          <view class="hero-kicker">车主端 · 驾驶证认证</view>
          <view class="hero-title">先完成驾驶证认证，再发布和接单</view>
          <view class="hero-desc">提交后会刷新审核状态，驳回原因会在此展示。</view>
        </view>
        <view class="topbar__aside">
          <text class="topbar__value">{{licenseStatusText}}</text>
          <text class="topbar__label">当前审核状态</text>
        </view>
      </view>
    </view>

    <empty-state
      wx:if="{{!authState.token}}"
      title="还没有登录"
      description="驾驶证认证需要登录账号和司机资料。"
    />

    <view wx:if="{{authState.token}}" class="panel-card">
      <view class="section-title">状态概览</view>
      <view class="meta-grid" style="margin-top: 18rpx;">
        <view class="meta-item">
          <text class="meta-item__label">司机状态</text>
          <text class="meta-item__value">{{driverStatusText}}</text>
        </view>
        <view class="meta-item">
          <text class="meta-item__label">驾驶证状态</text>
          <text class="meta-item__value">{{licenseStatusText}}</text>
        </view>
      </view>
      <view wx:if="{{showRejectReason}}" class="hero-note hero-note--warn">
        驳回原因：{{licenseStatus.rejectReason}}
      </view>
    </view>

    <view wx:if="{{authState.token}}" class="hero-card hero-card--accent">
      <view class="section-title">提交驾驶证资料</view>
      <view class="section-desc">填写证件号、领证日期和有效期后提交审核。</view>
      <view class="field-group" style="margin-top: 18rpx;">
        <text class="field-label">驾驶证号</text>
        <input class="field-input" data-field="licenseNo" value="{{licenseDraft.licenseNo}}" bindinput="handleInput" />
      </view>
      <view class="grid-two" style="margin-top: 18rpx;">
        <view class="field-group">
          <text class="field-label">初次领证日期</text>
          <picker mode="date" data-field="issueDate" value="{{licenseDraft.issueDate}}" bindchange="handleDateChange">
            <view class="field-picker">{{licenseDraft.issueDate}}</view>
          </picker>
        </view>
        <view class="field-group">
          <text class="field-label">有效期截止</text>
          <picker mode="date" data-field="expireDate" value="{{licenseDraft.expireDate}}" bindchange="handleDateChange">
            <view class="field-picker">{{licenseDraft.expireDate}}</view>
          </picker>
        </view>
      </view>
      <view class="field-group" style="margin-top: 18rpx;">
        <text class="field-label">图片 URL（可选）</text>
        <input class="field-input" data-field="imageUrl" value="{{licenseDraft.imageUrl}}" bindinput="handleInput" />
      </view>
      <view class="button-row" style="margin-top: 20rpx;">
        <button class="button-primary" bindtap="handleSubmit" loading="{{submitting}}">提交驾驶证</button>
      </view>
    </view>

    <view class="footer-space"></view>
  </view>

  <bottom-nav active="profile" />
</view>
