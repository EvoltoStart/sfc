<view class="page-shell">
  <view class="page-content">
    <view class="header-card">
      <view class="topbar">
        <view>
          <view class="hero-kicker">车主端 · 车辆管理</view>
          <view class="hero-title">把车辆资料补齐，发布页才能选车发单</view>
          <view class="hero-desc">新增车辆、查看审核状态，并设置默认发布车辆。</view>
        </view>
        <view class="topbar__aside">
          <text class="topbar__value">{{vehicles.length}}</text>
          <text class="topbar__label">车辆数量</text>
        </view>
      </view>
    </view>

    <empty-state
      wx:if="{{!authState.token}}"
      title="还没有登录"
      description="车辆管理需要登录账号才能读取司机资料和车辆列表。"
    />

    <view wx:if="{{authState.token}}" class="hero-card hero-card--accent">
      <view class="section-title">新增车辆</view>
      <view class="section-desc">提交后会刷新车辆列表和审核状态。</view>
      <view class="grid-two" style="margin-top: 18rpx;">
        <view class="field-group">
          <text class="field-label">品牌</text>
          <input class="field-input" data-field="brand" value="{{vehicleDraft.brand}}" bindinput="handleInput" />
        </view>
        <view class="field-group">
          <text class="field-label">车型</text>
          <input class="field-input" data-field="model" value="{{vehicleDraft.model}}" bindinput="handleInput" />
        </view>
      </view>
      <view class="grid-two" style="margin-top: 18rpx;">
        <view class="field-group">
          <text class="field-label">颜色</text>
          <input class="field-input" data-field="color" value="{{vehicleDraft.color}}" bindinput="handleInput" />
        </view>
        <view class="field-group">
          <text class="field-label">座位数</text>
          <input class="field-input" type="number" data-field="seatCount" value="{{vehicleDraft.seatCount}}" bindinput="handleInput" />
        </view>
      </view>
      <view class="field-group" style="margin-top: 18rpx;">
        <text class="field-label">车牌号</text>
        <input class="field-input" data-field="plateNo" value="{{vehicleDraft.plateNo}}" bindinput="handleInput" />
      </view>
      <view class="field-group" style="margin-top: 18rpx;">
        <text class="field-label">车辆图片 URL（可选）</text>
        <input class="field-input" data-field="vehicleImageUrl" value="{{vehicleDraft.vehicleImageUrl}}" bindinput="handleInput" />
      </view>
      <view class="button-row" style="margin-top: 20rpx;">
        <button class="button-primary" bindtap="handleCreateVehicle" loading="{{submitting}}">新增车辆</button>
      </view>
    </view>

    <view wx:if="{{authState.token}}" class="panel-card">
      <view class="section-title">已提交车辆</view>
      <empty-state
        wx:if="{{!vehicles.length}}"
        title="还没有车辆"
        description="新增车辆后，会显示审核状态和默认车辆设置入口。"
      />
      <view wx:for="{{vehicles}}" wx:key="id" class="record-card">
        <view class="record-card__header">
          <view>
            <view class="record-card__title">{{item.brand}} {{item.model}}</view>
            <view class="record-card__sub">{{item.color}} · {{item.plateNoMasked}} · {{item.seatCount}} 座</view>
          </view>
          <status-tag text="{{item.authMeta.label}}" tone="{{item.authMeta.tone}}" />
        </view>
        <view class="record-card__meta">
          <text>车辆 ID {{item.id}}</text>
          <text>{{item.defaultText}}</text>
        </view>
        <view class="record-card__actions">
          <button wx:if="{{!item.isDefault}}" class="button-ghost button-inline" data-id="{{item.id}}" bindtap="handleSetDefault">设为默认</button>
        </view>
      </view>
    </view>

    <view class="footer-space"></view>
  </view>

  <bottom-nav active="profile" />
</view>
