<view class="page-shell">
  <view class="page-content">
    <view class="header-card">
      <view class="topbar">
        <view>
          <view class="hero-kicker">车主端 · 钱包</view>
          <view class="hero-title">把收入、冻结金额和流水都接回真实钱包接口</view>
          <view class="hero-desc">完成支付并确认到达后，这里会开始出现真实结算流水。</view>
        </view>
        <view class="topbar__aside">
          <text class="topbar__value">{{availableBalanceText}}</text>
          <text class="topbar__label">可用余额（元）</text>
        </view>
      </view>
    </view>

    <empty-state
      wx:if="{{!authState.token}}"
      title="还没有登录"
      description="钱包页需要真实账号才能拉取余额和流水。"
    />

    <view wx:if="{{showWalletPanel}}" class="panel-card">
      <view class="section-title">余额概览</view>
      <view class="grid-two" style="margin-top: 18rpx;">
        <view class="summary-card">
          <text class="summary-card__value">{{availableBalanceText}}</text>
          <text class="summary-card__label">可用余额（元）</text>
        </view>
        <view class="summary-card">
          <text class="summary-card__value">{{frozenBalanceText}}</text>
          <text class="summary-card__label">冻结金额（元）</text>
        </view>
        <view class="summary-card">
          <text class="summary-card__value">{{totalIncomeText}}</text>
          <text class="summary-card__label">累计收入（元）</text>
        </view>
        <view class="summary-card">
          <text class="summary-card__value">{{totalWithdrawText}}</text>
          <text class="summary-card__label">累计提现（元）</text>
        </view>
      </view>
    </view>

    <view wx:if="{{authState.token}}" class="panel-card">
      <view class="section-title">最近流水</view>
      <empty-state
        wx:if="{{!ledger.length}}"
        title="还没有钱包流水"
        description="完成乘客支付并确认到达后，这里会显示真实结算记录。"
      />
      <view wx:for="{{ledger}}" wx:key="ledgerId" class="record-card">
        <view class="record-card__header">
          <view>
            <view class="record-card__title">{{item.bizTypeText}}</view>
            <view class="record-card__sub">{{item.createdText}}</view>
          </view>
          <view class="record-card__value">{{item.changeText}}</view>
        </view>
        <view class="record-card__meta">
          <text>流水号 {{item.ledgerId}}</text>
          <text>业务号 {{item.bizNo}}</text>
          <text>余额 {{item.balanceText}}</text>
        </view>
      </view>
    </view>

    <view class="footer-space"></view>
  </view>

  <bottom-nav active="profile" />
</view>
