<view class="page-shell">
  <view class="page-content">
    <view class="header-card">
      <view class="topbar">
        <view>
          <view class="hero-kicker">乘客端 · 可申请同行</view>
          <view class="hero-title">{{topTitleText}}</view>
          <view class="hero-desc">先看顺路度、距离、费用和安全能力，再决定要不要提交申请。</view>
        </view>
        <view class="topbar__aside">
          <text class="topbar__value">{{topRouteScoreText}}</text>
          <text class="topbar__label">当前顺路度</text>
        </view>
      </view>
    </view>

    <empty-state
      wx:if="{{!authState.token}}"
      title="还没有登录"
      description="行程详情需要登录账号，登录后可提交同行申请。"
      action-text="返回首页"
      bind:action="handleBack"
    />

    <view wx:if="{{showTripPanel}}" class="hero-card hero-card--accent">
      <view class="section-heading">
        <view class="section-heading__body">
          <view class="section-title">{{tripDetail.routeInfo.startName}} → {{tripDetail.routeInfo.endName}}</view>
          <view class="section-desc">预计 {{tripView.departText}} 出发，请确认费用、路线和剩余座位。</view>
        </view>
        <status-tag text="{{tripView.tripStatusMeta.label}}" tone="{{tripView.tripStatusMeta.tone}}" />
      </view>
      <view class="metrics-row" style="margin-top: 18rpx;">
        <view class="metric-pill">
          <text class="metric-pill__value">{{tripView.totalFeeText}}</text>
          <text class="metric-pill__label">预计费用</text>
        </view>
        <view class="metric-pill">
          <text class="metric-pill__value">{{tripView.distanceText}}</text>
          <text class="metric-pill__label">同行距离</text>
        </view>
        <view class="metric-pill">
          <text class="metric-pill__value">{{tripDetail.seatAvailable}}</text>
          <text class="metric-pill__label">剩余座位</text>
        </view>
      </view>
      <view class="route-line">
        <view class="route-step">
          <view class="route-step__dot"></view>
          <view>
            <text class="route-step__title">{{searchDraft.startName}}</text>
            <text class="route-step__desc">乘客上车点，将随同行申请提交。</text>
          </view>
        </view>
        <view class="route-step">
          <view class="route-step__dot route-step__dot--mid"></view>
          <view>
            <text class="route-step__title">{{tripDetail.routeInfo.startName}}</text>
            <text class="route-step__desc">司机路线起点，系统会按路线重合度计算顺路分。</text>
          </view>
        </view>
        <view class="route-step">
          <view class="route-step__dot route-step__dot--end"></view>
          <view>
            <text class="route-step__title">{{tripDetail.routeInfo.endName}}</text>
            <text class="route-step__desc">司机终点，也是当前展示的落客方向。</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{showTripPanel}}" class="panel-card">
      <view class="section-title">车主信息</view>
      <view class="record-card record-card--highlight" style="margin-top: 18rpx;">
        <view class="record-card__header">
          <view class="inline-row">
            <view class="avatar-badge">{{tripView.avatarText}}</view>
            <view>
              <view class="record-card__title">{{tripView.driverName}}</view>
              <view class="record-card__sub">{{tripView.ratingText}} · 行程 {{tripDetail.tripId}}</view>
            </view>
          </view>
          <status-tag text="{{tripView.routeScoreText}}" tone="safe" />
        </view>
        <view class="record-card__meta">
          <text>服务费 {{tripView.serviceFeeText}}</text>
          <text>分享能力 {{tripView.shareLabel}}</text>
        </view>
      </view>
      <view class="hero-note {{tripView.shareTone}}">
        {{tripView.shareNote}}
      </view>
    </view>

    <view wx:if="{{showTripPanel}}" class="button-row">
      <button class="button-secondary" bindtap="handleRefresh" loading="{{loading}}">刷新详情</button>
      <button class="button-primary" bindtap="handleApplyJoin" loading="{{applying}}">提交同行申请</button>
    </view>

    <view class="footer-space"></view>
  </view>

  <bottom-nav active="home" />
</view>
