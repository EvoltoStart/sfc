<view class="page-shell">
  <view class="page-content">
    <view class="header-card">
      <view class="topbar">
        <view>
          <view class="hero-kicker">支付确认 · 平台担保</view>
          <view class="hero-title">在线完成支付，再进入履约流程</view>
          <view class="hero-desc">支付完成后订单进入待上车状态，后续可继续确认上车与到达。</view>
        </view>
        <view class="topbar__aside">
          <text class="topbar__value">{{headerPaymentStatusText}}</text>
          <text class="topbar__label">支付状态</text>
        </view>
      </view>
    </view>

    <empty-state
      wx:if="{{!authState.token}}"
      title="还没有登录"
      description="支付确认页需要登录账号和有效订单。"
      action-text="返回订单"
      bind:action="handleBack"
    />

    <view wx:if="{{showOrderPanel}}" class="hero-card hero-card--accent">
      <view class="section-heading">
        <view class="section-heading__body">
          <view class="section-title">{{orderDetail.routeInfo.startName}} → {{orderDetail.routeInfo.endName}}</view>
          <view class="section-desc">订单 {{orderDetail.orderNo}} · {{orderView.departText}}</view>
        </view>
        <status-tag text="{{orderView.statusMeta.label}}" tone="{{orderView.statusMeta.tone}}" />
      </view>
      <view class="metrics-row" style="margin-top: 18rpx;">
        <view class="metric-pill">
          <text class="metric-pill__value">{{orderView.payableText}}</text>
          <text class="metric-pill__label">应付金额</text>
        </view>
        <view class="metric-pill">
          <text class="metric-pill__value">{{orderView.distanceText}}</text>
          <text class="metric-pill__label">同行距离</text>
        </view>
        <view class="metric-pill">
          <text class="metric-pill__value">{{orderView.serviceFeeText}}</text>
          <text class="metric-pill__label">平台服务费</text>
        </view>
      </view>
    </view>

    <view wx:if="{{showOrderPanel}}" class="panel-card">
      <view class="section-title">支付状态</view>
        <view class="record-card" style="margin-top: 18rpx;">
        <view class="record-card__header">
          <view>
            <view class="record-card__title">{{paymentCardTitle}}</view>
            <view class="record-card__sub">{{paymentCardSubText}}</view>
          </view>
          <status-tag text="{{paymentBadgeText}}" tone="{{paymentBadgeTone}}" />
        </view>
        <view class="record-card__meta">
          <text>金额 {{paymentAmountDisplayText}}</text>
          <text>状态 {{paymentStatusDisplayText}}</text>
        </view>
      </view>

      <view wx:if="{{paymentOrderView}}" class="hero-note hero-note--safe">
        支付单 {{paymentOrder.outTradeNo}} 已创建，预计过期时间 {{paymentOrderView.expireText}}。
      </view>
      <view wx:if="{{!paymentOrderView}}" class="hero-note hero-note--warn">
        当前还没有创建支付单，请先创建支付单。
      </view>
    </view>

    <view wx:if="{{showOrderPanel}}" class="panel-card">
      <view class="section-title">支付须知</view>
      <view class="info-strip" style="margin-top: 14rpx;">
        <view class="info-strip__title">平台先担保，再结算给车主</view>
        <view class="info-strip__desc">支付成功后不会直接把钱打给车主，等订单完成并确认到达后才会进入结算流程。</view>
      </view>
      <view class="info-strip" style="margin-top: 14rpx;">
        <view class="info-strip__title">支付状态以订单为准</view>
        <view class="info-strip__desc">支付结果会再次刷新订单和支付状态，避免重复操作。</view>
      </view>
    </view>

    <view wx:if="{{showOrderPanel}}" class="button-row">
      <button class="button-secondary" bindtap="handleCreatePaymentOrder" loading="{{creating}}">创建支付单</button>
      <button class="button-primary" bindtap="handleMockPayment" loading="{{mocking}}">确认支付成功</button>
      <button class="button-ghost" bindtap="handleOpenOrderDetail">回订单详情</button>
    </view>

    <view class="footer-space"></view>
  </view>

  <bottom-nav active="order" />
</view>
